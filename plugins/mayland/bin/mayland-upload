#!/usr/bin/env node

import { readFile } from "node:fs/promises";
import { extname, resolve } from "node:path";

const DEFAULT_MAYLAND_UPLOAD_ORIGIN = "https://mayland.frondorf.co";

function fail(message) {
  process.stderr.write(`${message}\n`);
  process.exit(1);
}

function contentTypeFromPath(filePath) {
  switch (extname(filePath).toLowerCase()) {
    case ".html":
    case ".htm":
      return "text/html";
    case ".eml":
      return "message/rfc822";
    case ".png":
      return "image/png";
    case ".jpg":
    case ".jpeg":
      return "image/jpeg";
    case ".gif":
      return "image/gif";
    case ".webp":
      return "image/webp";
    default:
      return "application/octet-stream";
  }
}

function isLocalOrigin(url) {
  return url.protocol === "http:" && /^(localhost|127\.0\.0\.1)$/.test(url.hostname);
}

function parseConfiguredOrigin(rawOrigin) {
  const trimmed = rawOrigin?.trim();
  if (!trimmed) return null;

  let url;
  try {
    url = new URL(trimmed);
  } catch {
    fail("MAYLAND_UPLOAD_ORIGIN is invalid.");
  }
  if (url.pathname !== "/" || url.search || url.hash || url.username || url.password) {
    fail("MAYLAND_UPLOAD_ORIGIN must be an exact origin.");
  }
  if (isLocalOrigin(url)) return url.origin;
  if (url.protocol !== "https:") fail("MAYLAND_UPLOAD_ORIGIN must use HTTPS unless it is localhost.");
  return url.origin;
}

function allowedOrigins() {
  const configuredOrigin = parseConfiguredOrigin(process.env.MAYLAND_UPLOAD_ORIGIN);
  return new Set([
    DEFAULT_MAYLAND_UPLOAD_ORIGIN,
    ...(configuredOrigin ? [configuredOrigin] : []),
  ]);
}

function validateUploadUrl(rawUrl) {
  let url;
  try {
    url = new URL(rawUrl);
  } catch {
    fail("Invalid Mayland upload target.");
  }

  const local = isLocalOrigin(url);
  if (!(url.protocol === "https:" || local)) fail("Mayland upload target must be HTTPS.");
  if (!local && !allowedOrigins().has(url.origin)) {
    fail("Unexpected Mayland upload origin.");
  }
  const acceptedPath = url.pathname.startsWith("/api/mcp/reference-upload/")
    || url.pathname.startsWith("/api/mcp/brand-asset-upload/");
  if (!acceptedPath) fail("Unexpected Mayland upload path.");
  if (url.username || url.password) fail("Credential-bearing upload URLs are not allowed.");
  return url;
}

const [, , rawUploadUrl, rawFilePath] = process.argv;
if (!rawUploadUrl || !rawFilePath) {
  fail("Usage: mayland-upload <upload-url> <file-path>");
}

const uploadUrl = validateUploadUrl(rawUploadUrl);
const filePath = resolve(rawFilePath);
const bytes = await readFile(filePath).catch(() => fail("Could not read the local file."));
if (!bytes || bytes.byteLength === 0) fail("The local file is empty.");

const response = await fetch(uploadUrl, {
  method: "POST",
  headers: {
    "content-type": contentTypeFromPath(filePath),
  },
  body: bytes,
}).catch(() => fail("Mayland upload failed."));

if (!response.ok) {
  fail("Mayland upload failed.");
}

const payload = await response.json().catch(() => ({}));
if (!payload || payload.uploaded !== true) {
  fail("Mayland upload response was incomplete.");
}
process.stdout.write("Upload complete.\n");
